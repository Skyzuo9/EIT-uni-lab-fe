{
  "name": "@unilab/workbench-theia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "theia-extension"
  ],
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.90.7",
    "@theia/core": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/workspace": "1.74.1",
    "@unilab/design-system": "workspace:*",
    "@unilab/material": "workspace:*",
    "@unilab/pascal-host": "workspace:*",
    "@unilab/pascal-lab-plugin": "workspace:*",
    "@unilab/services": "workspace:*",
    "@unilab/workflow-editor": "workspace:*",
    "@unilab/workflow-ide-bridge": "workspace:*",
    "@unilab/workbench-session": "workspace:*",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/theia-workflow-prototype-frontend-module"
    },
    {
      "backend": "lib/node/workbench-session-backend-module"
    }
  ]
}
