{
  "name": "@unilab/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Uni-Lab frontend monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @unilab/kernel-web dev",
    "dev:desktop": "pnpm --filter @unilab/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @unilab/kernel-web build",
    "build:desktop": "pnpm --filter @unilab/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e:workflow": "playwright test e2e/workflow-runtime.spec.ts",
    "test:e2e:materials": "UNILAB_E2E_HEADED=1 xvfb-run -a playwright test e2e/material-scene.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.93.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
